# Placeholders. Não coloque senha, token ou URL real neste arquivo.

DEVOLUCAO_ENV=production
DEVOLUCAO_HOST_PORT=

POSTGRES_DB=devolucao
POSTGRES_USER=devolucao_user
POSTGRES_PASSWORD=

# URL completa, com senha já percent-encoded. Host interno: devolucao-postgres
# Exemplo de forma, sem segredo:
# postgresql://devolucao_user:SENHA@devolucao-postgres:5432/devolucao
DATABASE_URL=

# Supabase externo: require. PostgreSQL privado deste compose: disable.
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=10
DB_POOL_RECYCLE=300
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10

DEVOLUCAO_AUTH_SECRET=

# Opcional. Só o pooler do Supabase usa este identificador. Vazio no PostgreSQL da VPS.
SUPABASE_PROJECT_REF=

PERF_MONITOR=0
